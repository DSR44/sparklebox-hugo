{
  "framework": "hugo",
  "buildCommand": "hugo --minify --gc",
  "build": {
    "env": {
      "HUGO_VERSION": "0.139.0",
      "HUGO_ENV": "production"
    }
  },
  "github": {
    "silent": true
  },
  "headers": [
    {
      "source": "/musebox-dreams",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}

