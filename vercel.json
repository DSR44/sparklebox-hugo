{
  "buildCommand": "npm install && npx hugo --minify",
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/**/*.py": {
      "excludeFiles": ["static/**", "content/**", "themes/**", "layouts/**", "assets/**", "node_modules/hugo-extended/**"]
    }
  },
  "github": {
    "silent": true
  },
  "headers": [
    {
      "source": "/musebox-dreams",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
