{
  "buildCommand": "hugo --minify",
  "outputDirectory": "public",
  "installCommand": "yum install -y golang && go install github.com/gohugoio/hugo@v0.139.0",
  "build": {
    "env": {
      "HUGO_ENV": "production"
    }
  },
  "github": {
    "silent": true
  },
  "headers": [
    {
      "source": "/musebox-dreams",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}

