{
  "buildCommand": "npm install && npx hugo --minify",
  "outputDirectory": "public",
  "framework": null,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "sparklebox.blog" }],
      "destination": "https://www.sparklebox.blog/:path*",
      "permanent": true
    }
  ],
  "github": {
    "silent": true
  },
  "headers": [
    {
      "source": "/musebox-dreams",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
