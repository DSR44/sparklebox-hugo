{
  "buildCommand": "./build.sh",
  "build": {
    "env": {
      "HUGO_ENV": "production",
      "GIT_LFS_SKIP_SMUDGE": "1"
    }
  },
  "github": {
    "silent": true
  },
  "headers": [
    {
      "source": "/musebox-dreams",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}

